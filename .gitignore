# Byte-compiled / optimized files
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/

# Entornos virtuales
.venv/
venv/
env/
ENV/

# Archivos de entorno y configuracion local (pueden tener credenciales)
.env
.env.*

# Editores e IDEs
.vscode/
.idea/

# Archivos del sistema operativo
.DS_Store
Thumbs.db

# Datos y reportes generados por los scripts (simulacion, exportacion, limpieza y graficas)
datos/
reportes/

# Archivos CSV y Excel: se regeneran con los scripts, no se versionan
*.csv
*.xlsx
~$*.xlsx
